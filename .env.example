# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser.
# Get this from Project Settings → API → service_role (secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Hold configuration (optional)
APPOINTMENT_HOLD_DURATION_SECONDS=300
APPOINTMENT_SLOT_GENERATION_DAYS_AHEAD=60
APPOINTMENT_DEFAULT_TIMEZONE=UTC

# Appointment reminder (optional, used by runner cron/jobs)
APPOINTMENT_REMINDER_HOURS_BEFORE=24
MEDICATION_REMINDER_LOOKAHEAD_MINUTES=5

# AI — Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# Email provider — use "stub" for local/dev, "resend" or "sendgrid" for production
EMAIL_PROVIDER=stub
RESEND_API_KEY=your-resend-key
SENDGRID_API_KEY=your-sendgrid-key
EMAIL_FROM=noreply@yourhospital.com

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# Encryption — used for OAuth tokens
ENCRYPTION_SALT=change-this-to-a-random-string

# Public site config
NEXT_PUBLIC_SITE_NAME=Hospital Management System
NEXT_PUBLIC_SITE_URL=http://localhost:3000
