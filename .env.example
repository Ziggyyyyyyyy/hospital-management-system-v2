# ==============================================================================
# Hospital Management System (HMS) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit real credentials, tokens, or secret keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database & Authentication)
# ------------------------------------------------------------------------------
# Get these from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# Secret service role key (Server-only — NEVER expose to browser)
# Used for backend operations, RLS bypass, and administrative routines
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# ------------------------------------------------------------------------------
# 2. AI / LLM (Google Gemini)
# ------------------------------------------------------------------------------
# Google Gemini API key for pre-visit symptom intake & post-visit notes
# https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-placeholder

# ------------------------------------------------------------------------------
# 3. Email & Notification Delivery
# ------------------------------------------------------------------------------
# Provider to use: "stub" (dev/local logger), "resend" (production HTTP), or "sendgrid"
EMAIL_PROVIDER=stub

# Resend API Key (starts with re_...)
# https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_placeholder

# SendGrid API Key (alternative provider option)
SENDGRID_API_KEY=your_sendgrid_api_key_placeholder

# Verified sender email address / domain
EMAIL_FROM=noreply@yourhospital.com

# ------------------------------------------------------------------------------
# 4. Google Calendar Integration & OAuth Vault
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Credentials
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id-placeholder
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret-placeholder

# OAuth 2.0 Redirect URI (must match Google Cloud Console Authorized Redirect URIs)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# Master key / salt used for AES-256-GCM encryption of OAuth tokens at rest
ENCRYPTION_MASTER_KEY=your-32-byte-master-key-placeholder
ENCRYPTION_SALT=your-random-encryption-salt-placeholder

# ------------------------------------------------------------------------------
# 5. Application & Scheduling Configuration
# ------------------------------------------------------------------------------
# Public branding & site URLs
NEXT_PUBLIC_SITE_NAME=Hospital Management System
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Appointment slot hold duration in seconds (default: 300 = 5 minutes)
APPOINTMENT_HOLD_DURATION_SECONDS=300

# Number of days ahead for doctor slot generation (default: 60)
APPOINTMENT_SLOT_GENERATION_DAYS_AHEAD=60

# Default fallback timezone for appointment bookings
APPOINTMENT_DEFAULT_TIMEZONE=UTC

# Lookahead window for upcoming appointment reminders in hours (default: 24)
APPOINTMENT_REMINDER_HOURS_BEFORE=24

# Lookahead window in minutes for medication reminder batch processing (default: 5)
MEDICATION_REMINDER_LOOKAHEAD_MINUTES=5
